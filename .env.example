# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase Anda.
# Ambil nilai URL dan ANON KEY dari: Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Opsional: Kredensial Akun Demo Juri (buat user ini di Supabase Auth atau jalankan otomatis lewat tombol 1-Klik)
NEXT_PUBLIC_DEMO_JUDGE_EMAIL=juri.demo@signify.id
NEXT_PUBLIC_DEMO_JUDGE_PASSWORD=SignifyItRush2026!

# Khusus CLI / Server (JANGAN gunakan prefix NEXT_PUBLIC_): dipakai oleh scripts/upload_word_demos_supabase.py
# untuk mengunggah video animasi kosakata BISINDO ke Supabase Storage & tabel public.bisindo_word_demos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
