# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase Anda.
# Ambil nilai URL dan ANON KEY dari: Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

